# ------------------------------------------------------------------
# Fam environment template. Copy to .env and fill in.
# NEVER commit real secrets. Only EXPO_PUBLIC_*/NEXT_PUBLIC_* are safe
# to expose to a client bundle; everything else is server/Edge only.
# ------------------------------------------------------------------

# ---- mobile (public, bundled into the app) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=          # publishable/anon key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=local               # local | staging | production

# ---- admin (public, bundled into the web app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local

# ---- server-only (Edge Function secrets / CI / Vault) ----
# Never expose these to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=                           # used by Edge Functions + pg_net
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=
SENTRY_AUTH_TOKEN=                      # CI: source-map upload

# ---- Edge Functions (set with `supabase secrets set`) ----
SUPABASE_ANON_KEY=                      # anon/publishable key for user-scoped clients
ALLOWED_ORIGINS=                        # comma-separated CORS allowlist, e.g. https://admin.fam.app
ADMIN_REQUIRE_MFA=true                  # platform-admin actions require AAL2 (set false only for local dev)

# ---- Supabase Vault (created once per project, not env vars) ----
# select vault.create_secret('<service-role-key>', 'service_role_key');
# select vault.create_secret('https://<ref>.supabase.co', 'project_url');
