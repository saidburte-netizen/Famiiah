# ------------------------------------------------------------------
# Fam environment template. Copy to .env and fill in.
# NEVER commit real secrets. Only EXPO_PUBLIC_*/NEXT_PUBLIC_* are safe
# to expose to a client bundle; everything else is server/Edge only.
# ------------------------------------------------------------------

# ---- mobile (public, bundled into the app) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=          # publishable/anon key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=local               # local | staging | production

# ---- admin (public, bundled into the web app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local

# ---- server-only (Edge Function secrets / CI / Vault) ----
# Never expose these to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=                           # used by Edge Functions + pg_net
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=
SENTRY_AUTH_TOKEN=                      # CI: source-map upload
