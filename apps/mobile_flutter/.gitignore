# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/
# Resolved fresh in CI (the workflow runs `flutter pub get`), so the lock is not
# committed — keep it out of commits made with `git add -A`.
pubspec.lock
# Generated on demand by tool/setup_android.sh; it carries a binary
# gradle-wrapper.jar, so the platform project is deliberately not committed.
# Anchored to the project root so it does not also hide the committed branding
# assets under assets/branding/android/.
/android/
